{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**",
    "workbench/**"
  ]
}