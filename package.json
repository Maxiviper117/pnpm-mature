{
  "name": "@maxiviper117/pnpm-mature",
  "version": "0.1.0",
  "description": "Maturity-aware pnpm wrapper for age-constrained dependency updates.",
  "homepage": "https://github.com/Maxiviper117/pnpm-mature#readme",
  "bugs": {
    "url": "https://github.com/Maxiviper117/pnpm-mature/issues"
  },
  "license": "MIT",
  "author": "Maxiviper117",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxiviper117/pnpm-mature.git"
  },
  "type": "module",
  "private": false,
  "bin": {
    "pnpm-mature": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node",
    "check": "tsc --noEmit",
    "dev": "bun run src/cli.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "bun run check && bun run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.17",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.4",
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "semver": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/semver": "^7.7.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^3.2.4"
  }
}
