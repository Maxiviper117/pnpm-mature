{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "node_modules/**",
    "*.min.js",
    "coverage/**",
    "*.md",
    "*.json",
    "bun.lock",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**",
    "workbench/**"
  ]
}